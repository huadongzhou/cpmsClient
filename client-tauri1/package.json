{
  "name": "cpms-client-tauri1",
  "version": "0.1.8",
  "private": true,
  "scripts": {
    "dev:ui": "pnpm --dir ../client-ui dev:legacy",
    "build:ui": "pnpm --dir ../client-ui build:legacy",
    "tauri": "tauri",
    "dev": "tauri dev",
    "build": "tauri build --config src-tauri/tauri.linux.conf.json --bundles deb rpm",
    "build:linux": "tauri build --config src-tauri/tauri.linux.conf.json --bundles deb rpm",
    "build:linux:x64": "tauri build --config src-tauri/tauri.linux.conf.json --target x86_64-unknown-linux-gnu --bundles deb rpm",
    "build:linux:arm64": "tauri build --config src-tauri/tauri.linux.conf.json --target aarch64-unknown-linux-gnu --bundles deb rpm",
    "build:linux:deb": "tauri build --config src-tauri/tauri.linux.conf.json --bundles deb",
    "build:linux:rpm": "tauri build --config src-tauri/tauri.linux.conf.json --bundles rpm",
    "build:linux:appimage": "tauri build --config src-tauri/tauri.linux.conf.json --bundles appimage"
  },
  "dependencies": {
    "@tauri-apps/api": "1.6.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "1.6.3"
  }
}
